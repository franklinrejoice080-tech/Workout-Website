# ASCEND Coach — serverless AI integration
#
# Copy this file to .env for local development (or set the variables in the
# Vercel dashboard for production). Values are NEVER committed to Git.
#
# Required for /api/coach to call OpenRouter:
OPENROUTER_API_KEY=
#
# Optional — model override (default: openrouter/free — OpenRouter's free
# model router). Set to any OpenRouter model ID, e.g.:
# OPENROUTER_MODEL=openrouter/free
